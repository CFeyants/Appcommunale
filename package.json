{
  "name": "plateforme-citoyenne",
  "private": true,
  "version": "2.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "Plateforme citoyenne belge — cinq niveaux de pouvoir, une seule lecture.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pc/web",
    "build": "npm run build --workspace=@pc/web",
    "start": "npm run start --workspace=@pc/web",
    "lint": "npm run lint --workspace=@pc/web",
    "test": "tsx --test packages/core/test/*.test.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "ingest": "tsx packages/connectors/src/cli/ingest.ts",
    "ingest:lokaalbeslist": "tsx packages/connectors/src/cli/ingest.ts lokaalbeslist"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
